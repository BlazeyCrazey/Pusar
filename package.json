{
  "name": "pusar",
  "productName": "Pusar",
  "version": "0.0.1",
  "private": true,
  "description": "Pusar Launcher",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "node scripts/dev.mjs",
    "spike": "node scripts/dev.mjs -- --spike",
    "selftest": "electron-vite build && electron . --selftest",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json --composite false && tsc --noEmit -p tsconfig.web.json --composite false",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "electron-vite build && playwright test",
    "check": "npm run lint && npm run typecheck && npm run test && npm run test:e2e",
    "package:dir": "electron-vite build && electron-builder --dir",
    "package": "electron-vite build && electron-builder --win"
  },
  "dependencies": {
    "@xhayper/discord-rpc": "^1.5.1",
    "fflate": "^0.8.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@playwright/test": "^1.65.0",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-toast": "^1.3.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "msw": "^3.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "roblox-bat": "^0.6.5",
    "typescript": "~6.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "zustand": "^5.1.0"
  }
}
